# ============================================================================
# EXEMPLE d'environnement - Ne jamais committer ni copier telquel!
# Copier en secrets.env:
#   cp secrets.env.example ../config/secrets.env
# et remplir vos valeurs réelles.
# ============================================================================

# Clé API OpenAI-compatible exposée par llama-server (vide = auth DISABLEE)
# Pour activer l'auth, mettre une chaîne de 24+ carères.
LLM_API_KEY=

# Client Hermes Agent : adresse IP du PC client autorisé à consommer l'API
CLIENT_IP=192.168.1.50

# Coordonnées du serveur
LISTEN_HOST=0.0.0.0
LISTEN_PORT=8080

# Surveillance de la connexion Internet par NetworkManager
INTERNET_CHECK_URL=https://connectivitycheck.gstatic.com/generate_204
INTERNET_CHECK_INTERVAL=30
NETWORK_INTERFACE=

# Compte dedie au service LLM. Il n'ouvre pas de session graphique.
LLM_USER=llmuser
MODEL_DIR=/opt/models
LOGDIR=/opt/hermes-llm/logs

# Contexte en tokens : >=65538 OBLIGATOIRE (Hermes HARD requirement)
# 73728 = 72K, avec marge sous la limite 65538 demandée.
CTX_SIZE=73728

# Quant & chemin vers le .gguf (déplacé dans /opt/models par le launcher)
MODEL_FILENAME=Ornith-1.5-35B-A3B-Q4_K_M.gguf
